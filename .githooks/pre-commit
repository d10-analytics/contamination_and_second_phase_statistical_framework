#!/bin/sh
# Rejects staged additions containing forbidden markers. The hooks directory is exempt
# because it necessarily contains the pattern list.
dir=$(dirname "$0")
if ! git diff --cached -U0 --no-color --diff-filter=ACMR -- . ':(exclude).githooks' \
    | grep -E '^(\+[^+]|\+$|\+\+\+ )' | "$dir/check-markings"; then
    echo "pre-commit: forbidden marker found in staged changes (see lines above)." >&2
    exit 1
fi
